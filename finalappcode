# ---------------------------
# App configuration
# ---------------------------
EYE_CASCADE_FILENAME = "haarcascade_eye.xml"
BOX_W, BOX_H = 240, 200
MIN_EYE_SIZE = 60   # minimum width/height accepted for an eye inside the box

# ---------------------------
# Globals
# ---------------------------
cap = None
eye_cascade = None

scanning_left = True
left_conf = None
right_conf = None
final_data = {}

# ---------------------------
# Utilities
# ---------------------------
def preprocess_eye_roi_color(roi_bgr):
    try:
        img = cv2.cvtColor(roi_bgr, cv2.COLOR_BGR2RGB)
        img = cv2.resize(img, (128, 128))
        img = img.astype("float32") / 255.0
        img = np.expand_dims(img, axis=0)
        return img
    except Exception:
        return None

def classify_from_conf(conf):
    if conf is None:
        return "N/A"
    if conf <= 0.3:
        return "NORMAL"
    elif conf >= 0.7:
        return "MYOPIA"
    else:
        return "OTHER / INCONCLUSIVE"

def map_confidence_to_diopter(conf):
    # Example mapping — tune based on your dataset/labels
    if conf is None:
        return None
    diopter = -1.0 - (conf * 5.0)  # approx -1.0 to -6.0 for conf 0->1
    diopter = max(diopter, -12.0)
    return round(diopter, 2)

# ---------------------------
# Scan button logic
# ---------------------------
def scan_eye_button():
    global scanning_left, left_conf, right_conf

    if cap is None or not cap.isOpened():
        messagebox.showerror("Camera Error", "Webcam not available.")
        return

    ret, frame = cap.read()
    if not ret:
        messagebox.showerror("Camera Error", "Failed to read from webcam.")
        return

    h, w = frame.shape[:2]
    bx1 = w // 2 - BOX_W // 2
    by1 = h // 2 - BOX_H // 2
    bx2 = bx1 + BOX_W
    by2 = by1 + BOX_H

    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    eyes = eye_cascade.detectMultiScale(gray, scaleFactor=1.1, minNeighbors=5, minSize=(30,30))

    # Strict: accept only eyes whose centroid lies inside box and size >= MIN_EYE_SIZE
    eyes_in_box = []
    for (ex, ey, ew, eh) in eyes:
        cx = ex + ew // 2
        cy = ey + eh // 2
        if bx1 <= cx <= bx2 and by1 <= cy <= by2 and ew >= MIN_EYE_SIZE and eh >= MIN_EYE_SIZE:
            eyes_in_box.append((ex, ey, ew, eh))

    if len(eyes_in_box) == 0:
        messagebox.showwarning("Alignment", "No suitable eye detected inside the box. Place one eye centered in the box and try again.")
        return
    if len(eyes_in_box) > 1:
        messagebox.showwarning("Alignment", "Multiple eye regions detected inside the box. Make sure only one eye is inside the box.")
        return

    ex, ey, ew, eh = eyes_in_box[0]
    roi_color = frame[ey:ey+eh, ex:ex+ew]
    input_img = preprocess_eye_roi_color(roi_color)
    if input_img is None:
        messagebox.showerror("Processing Error", "Failed to preprocess eye image.")
        return

    try:
        pred = model.predict(input_img)[0][0]
        pred = float(pred)
    except Exception as e:
        messagebox.showerror("Model Error", f"Prediction failed: {e}")
        return

    if scanning_left:
        left_conf = pred
        status_label.config(text=f"LEFT scanned — conf {left_conf*100:.1f}%")
        scan_btn.config(text="Scan RIGHT Eye")
        scanning_left = False
    else:
        right_conf = pred
        status_label.config(text=f"RIGHT scanned — conf {right_conf*100:.1f}%")
        scan_btn.config(state=DISABLED)
        final_btn.config(state=NORMAL)
        scanning_left = True

    left_status_label.config(text=f"Left: {left_conf*100:.1f}%" if left_conf is not None else "Left: --")
    right_status_label.config(text=f"Right: {right_conf*100:.1f}%" if right_conf is not None else "Right: --")

# ---------------------------
# Final analysis
# ---------------------------
def show_final_result():
    global final_data
    if left_conf is None or right_conf is None:
        messagebox.showwarning("Incomplete", "Please complete both LEFT and RIGHT scans before showing final result.")
        return

    max_conf = max(left_conf, right_conf)
    classification = classify_from_conf(max_conf)

    if classification == "NORMAL":
        diopter_text = "0.0 D"
        color = "green"
    elif classification == "MYOPIA":
        diopter_val = map_confidence_to_diopter(max_conf)
        diopter_text = f"{diopter_val} D" if diopter_val is not None else "--"
        color = "red"
    else:
        diopter_text = "-- Consult Specialist --"
        color = "orange"

    final_result_label.config(text=classification, fg=color)
    diopter_label.config(text=diopter_text, fg=color)
    save_btn.config(state=NORMAL)

    final_data = {
        "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
        "left_confidence": f"{left_conf*100:.1f}%",
        "right_confidence": f"{right_conf*100:.1f}%",
        "classification": classification,
        "diopter": diopter_text
    }
    status_label.config(text="Analysis complete.")

# ---------------------------
# Save report
# ---------------------------
def save_report():
    if not final_data:
        messagebox.showwarning("No Data", "There's no final result to save.")
        return
    file_path = filedialog.asksaveasfilename(defaultextension=".txt",
                                             filetypes=[("Text files","*.txt")],
                                             initialfile=f"Myopia_Report_{time.strftime('%Y%m%d_%H%M%S')}.txt")
    if not file_path:
        return
    try:
        with open(file_path, "w") as f:
            f.write("--- Eye Diopter Scanner Report ---\n")
            f.write(f"Scan Date: {final_data['timestamp']}\n")
            f.write("----------------------------------\n")
            f.write(f"FINAL DIAGNOSIS: {final_data['classification']}\n")
            f.write(f"DIOPTER ESTIMATE: {final_data['diopter']}\n")
            f.write("----------------------------------\n")
            f.write(f"Left Eye Confidence: {final_data['left_confidence']}\n")
            f.write(f"Right Eye Confidence: {final_data['right_confidence']}\n")
            f.write("----------------------------------\n")
            f.write("Disclaimer: This is a preliminary computer-generated prediction and does not replace a professional eye examination.\n")
        messagebox.showinfo("Saved", f"Report saved to:\n{file_path}")
    except Exception as e:
        messagebox.showerror("Save Error", f"Unable to save report: {e}")

# ---------------------------
# Reset session
