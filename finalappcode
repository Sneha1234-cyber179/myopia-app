    left_status_label.config(text="Left: --")
    right_status_label.config(text="Right: --")
    final_result_label.config(text="--")
    diopter_label.config(text="--")
    status_label.config(text="Ready. Place LEFT eye in the box and press Scan.")

# ---------------------------
# Video & guidance overlay
# ---------------------------
def update_video():
    if cap is None:
        root.after(50, update_video)
        return

    ret, frame = cap.read()
    if not ret:
        root.after(50, update_video)
        return

    frame = cv2.flip(frame, 1)
    h, w = frame.shape[:2]
    bx1 = w // 2 - BOX_W // 2
    by1 = h // 2 - BOX_H // 2
    bx2 = bx1 + BOX_W
    by2 = by1 + BOX_H

    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    eyes = eye_cascade.detectMultiScale(gray, scaleFactor=1.1, minNeighbors=5, minSize=(30,30))

    eyes_in_box = []
    for (ex, ey, ew, eh) in eyes:
        cx = ex + ew//2
        cy = ey + eh//2
        if bx1 <= cx <= bx2 and by1 <= cy <= by2 and ew >= MIN_EYE_SIZE and eh >= MIN_EYE_SIZE:
            eyes_in_box.append((ex, ey, ew, eh))

    aligned = (len(eyes_in_box) == 1)
    box_color = (0,255,0) if aligned else (0,0,255)

    overlay = frame.copy()
    cv2.rectangle(overlay, (bx1, by1), (bx2, by2), box_color, 3)
    alpha = 0.12
    frame = cv2.addWeighted(overlay, alpha, frame, 1 - alpha, 0)
    cv2.rectangle(frame, (bx1, by1), (bx2, by2), box_color, 3)

    for (ex, ey, ew, eh) in eyes:
        cv2.rectangle(frame, (ex, ey), (ex+ew, ey+eh), (180,180,180), 1)

    target_eye_text = "LEFT" if scanning_left else "RIGHT"
    cv2.putText(frame, f"Target: {target_eye_text} eye - place inside box", (10,30),
                cv2.FONT_HERSHEY_SIMPLEX, 0.7, (240,240,240), 2)

    if not aligned:
        cv2.putText(frame, "Align one eye inside the box (green) for scanning", (10,60),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0,0,255), 2)
    else:
        cv2.putText(frame, "Good alignment — press Scan", (10,60),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0,255,0), 2)

    img_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    img_pil = Image.fromarray(img_rgb)
    imgtk = ImageTk.PhotoImage(image=img_pil)
    video_label.imgtk = imgtk
    video_label.configure(image=imgtk)

    video_label.after(20, update_video)

